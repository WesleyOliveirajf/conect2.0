# Configurações de Ambiente - Torp Huddle Space
# Copie este arquivo para .env e configure as variáveis necessárias
# IMPORTANTE: Nunca commite o arquivo .env real com valores sensíveis

# ========================================
# CONFIGURAÇÕES DE SEGURANÇA (OBRIGATÓRIAS)
# ========================================

# Login admin: Supabase Auth (e-mail/senha). Crie o usuário no painel do Supabase e
# promova-o a admin (veja supabase/migrations/20260101000006_admin_role_policies.sql).

# Salt para criptografia (OBRIGATÓRIO em produção) 
# Use um valor aleatório único para cada instalação
# Exemplo: gere uma string aleatória de 32+ caracteres
VITE_ENCRYPTION_SALT=SeuSaltUnicoAleatorio2025

# ========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ========================================

# Nome da aplicação
VITE_APP_NAME=Torp Huddle Space

# Versão da aplicação
VITE_APP_VERSION=1.0.0

# URL base da aplicação (para PWA e links)
# Em produção, use a URL real do seu domínio
VITE_APP_URL=http://localhost:8080

# ========================================
# CONFIGURAÇÕES PWA
# ========================================

# Nome curto para PWA (máximo 12 caracteres)
VITE_PWA_SHORT_NAME=Connect10

# Descrição da aplicação
VITE_PWA_DESCRIPTION=Espaço para unir, informar e transformar a equipe TORP

# Cor do tema da aplicação
VITE_PWA_THEME_COLOR=#1a365d

# Cor de fundo da aplicação
VITE_PWA_BACKGROUND_COLOR=#ffffff

# ========================================
# CONFIGURAÇÕES DO SUPABASE
# ========================================

# URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
# Obtenha no painel do seu projeto Supabase > Settings > API
VITE_SUPABASE_URL=your_supabase_project_url

# Chave pública (anon key) do Supabase
# Obtenha no painel do seu projeto Supabase > Settings > API
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Controla migração automática do localStorage para o Supabase quando a tabela estiver vazia
# Use 'true' apenas na primeira carga para popular; em produção mantenha 'false'
VITE_ENABLE_AUTO_MIGRATION=false

# ========================================
# CONFIGURAÇÕES DO CLIMATEMPO
# ========================================

# Token privado da Climatempo.
# Configure no ambiente do servidor/hosting, não no front-end.
CLIMATEMPO_TOKEN=

# Juiz de Fora - MG
CLIMATEMPO_LOCALE_ID=152

# ========================================
# CONFIGURAÇÕES DE IA/CHATBOT
# ========================================

# Groq (chatbot): configure GROQ_API_KEY SOMENTE no servidor (Vercel > Settings > Environment Variables).
# NUNCA use o prefixo VITE_ — ele embute a chave no JavaScript público.
# GROQ_API_KEY=

# ========================================
# CONFIGURAÇÕES DO RAG (RETRIEVAL-AUGMENTED GENERATION)
# ========================================

# URL do site para indexação e busca de contexto (OBRIGATÓRIO para RAG)
# O chatbot usará o conteúdo deste site para responder perguntas
# Exemplo: https://www.suaempresa.com
VITE_RAG_WEBSITE_URL=https://example.com

# Número máximo de páginas para fazer scraping (padrão: 20)
# Ajuste conforme o tamanho do site e recursos disponíveis
VITE_RAG_MAX_PAGES=20

# Configurações avançadas do RAG (opcionais)
# Limite de resultados de busca semântica
# VITE_RAG_SEARCH_LIMIT=5

# Similaridade mínima para considerar conteúdo relevante (0.0 a 1.0)
# VITE_RAG_MIN_SIMILARITY=0.1

# Tamanho máximo do contexto enviado para o LLM
# VITE_RAG_CONTEXT_MAX_LENGTH=2000

# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================

# Porta do servidor de desenvolvimento
VITE_DEV_PORT=8080

# Habilitar logs de debug (true/false)
VITE_DEBUG_MODE=false

# ========================================
# CONFIGURAÇÕES DE INTEGRAÇÃO
# ========================================

# URL base para integração com Microsoft Teams (opcional)
# Exemplo: https://teams.microsoft.com/l/chat/0/0?users=
VITE_TEAMS_BASE_URL=

# ========================================
# CONFIGURAÇÕES DE CACHE
# ========================================

# Tempo de cache em milissegundos (padrão: 24 horas)
VITE_CACHE_DURATION=86400000

# Versão do cache (incremente para forçar atualização)
VITE_CACHE_VERSION=1

# ========================================
# CONFIGURAÇÕES DE RATE LIMITING
# ========================================

# Máximo de tentativas de login por IP
VITE_MAX_LOGIN_ATTEMPTS=5

# Tempo de bloqueio em minutos após exceder tentativas
VITE_LOGIN_BLOCK_DURATION=15

# ========================================
# CONFIGURAÇÕES DE SESSÃO
# ========================================

# Duração da sessão administrativa em minutos
VITE_SESSION_DURATION=30

# Aviso de expiração da sessão em minutos antes do fim
VITE_SESSION_WARNING_TIME=5
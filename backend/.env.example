# ----- Climatempo (Clima — opcional) -----
# Sem token, usa Open-Meteo gratuitamente como fallback
CLIMATEMPO_TOKEN=
CLIMATEMPO_LOCALE_ID=152

# ----- Rate Limiting -----
# Requisições por segundo por IP
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=50

# ----- CORS -----
# Origens permitidas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

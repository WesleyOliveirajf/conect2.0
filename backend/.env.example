# Chave anon/publishable (frontend)
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR1ZHV6d255cWV1ZWRiYXFuYnNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTgyNzczMjksImV4cCI6MjA3Mzg1MzMyOX0.AZAff6_lSH12UnFrZvMNOFGprCAJR50-81MD8m48W6M

# Chave de serviço (service_role) — NÃO exponha no frontend
